# NODE Research 증시 캘린더 — 실제 값은 .env에 작성 (.env는 git에 올라가지 않음)
# 모두 선택 사항: 없어도 실적·경제지표·고정일정·학회 수집은 동작함

# 해외 실적 원거리(약 2.5개월 이후) 보강용 — 없으면 Nasdaq·TradingView만 사용
FINNHUB_API_KEY=

# AI 뉴스 스캐너(돌발 일정 추출)용 Claude
#   API 크레딧이 있으면 API 사용, 없거나 부족하면 Claude Code CLI(구독 로그인)로 자동 전환
ANTHROPIC_API_KEY=
#   서버·GitHub Actions처럼 브라우저 로그인이 안 되는 곳: `claude setup-token`으로 발급한 구독 토큰
CLAUDE_CODE_OAUTH_TOKEN=
#   auto(기본) | api | cli
LLM_BACKEND=auto
CALENDAR_SCANNER_MODEL=claude-haiku-4-5-20251001
